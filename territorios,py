import math
from random import randint, sample, random

class TerritoriosGA:
    def __init__(self):
        self.num_equipes = 4
        self.bairros = [
            [3.0, 7.5], [6.9, 1.6], [4.7, 7.7], [6.0, 8.0], [7.4, 0.8],
            [7.7, 0.1], [6.0, 3.3], [7.0, 2.9], [2.4, 9.1], [6.0, 6.9],
            [7.0, 6.0], [5.0, 8.1], [1.9, 2.9], [8.1, 1.9], [6.6, 4.9],
            [9.4, 0.1], [8.5, 9.9], [0.8, 2.0], [9.7, 7.5], [0.5, 3.8],
            [9.9, 0.3], [3.4, 6.0], [7.6, 9.2], [4.9, 9.1]
        ]
        self.total_bairros = len(self.bairros)
        self.meta_por_equipe = self.total_bairros // self.num_equipes

        self.tamanho_populacao = 50
        self.taxa_de_cruzamento = 0.90
        self.taxa_de_mutacao_gene = 1.0 / self.total_bairros
        self.geracoes_maxima = 250
        self.torneio = 4
        self.populacao = []

    def _distancia(self, i, j):
        p1, p2 = self.bairros[i], self.bairros[j]
        return math.hypot(p1[0] - p2[0], p1[1] - p2[1])

    def inicializar_populacao(self):
        self.populacao = []
        for _ in range(self.tamanho_populacao):
            base = [eq for eq in range(self.num_equipes) for _ in range(self.meta_por_equipe)]
            ind = sample(base, len(base))
            self.populacao.append(ind)

    def fitness(self, individuo):
        soma_distancias = 0.0
        contagem = [0] * self.num_equipes

        for eq in range(self.num_equipes):
            membros = [i for i, e in enumerate(individuo) if e == eq]
            contagem[eq] = len(membros)
            for i in range(len(membros)):
                for j in range(i + 1, len(membros)):
                    soma_distancias += self._distancia(membros[i], membros[j])

        penalidade = sum(abs(c - self.meta_por_equipe) for c in contagem) * 50.0
        return soma_distancias + penalidade

    def selecao_dos_pais(self):
        pai = min(sample(self.populacao, k=self.torneio), key=self.fitness)
        mae = min(sample(self.populacao, k=self.torneio), key=self.fitness)
        return pai, mae

    def cruzamento(self, pai, mae):
        corte = randint(1, self.total_bairros - 1)
        return pai[:corte] + mae[corte:], mae[:corte] + pai[corte:]

    def mutar(self, filho):
        for gene in range(len(filho)):
            if random() < self.taxa_de_mutacao_gene:
                filho[gene] = randint(0, self.num_equipes - 1)

    def reproducao_da_geracao(self):
        prole = []
        for _ in range(self.tamanho_populacao // 2):
            pai, mae = self.selecao_dos_pais()
            filho1, filho2 = (self.cruzamento(pai, mae) if random() < self.taxa_de_cruzamento 
                              else (pai[:], mae[:]))
            self.mutar(filho1)
            self.mutar(filho2)
            prole.extend([filho1, filho2])
        return prole

    def selecao_dos_sobreviventes(self, prole):
        melhor_antigo = min(self.populacao, key=self.fitness)
        pior_filho = max(prole, key=self.fitness)
        prole.remove(pior_filho)
        self.populacao = [melhor_antigo[:]] + prole

    def melhor(self):
        return min(self.populacao, key=self.fitness)

    def evolucao(self):
        self.inicializar_populacao()
        for _ in range(self.geracoes_maxima):
            prole = self.reproducao_da_geracao()
            self.selecao_dos_sobreviventes(prole)

    def saida(self):
        solucao = self.melhor()
        print("=== Exercício 4: Agentes de Saúde ===")
        print(f"Fitness final: {self.fitness(solucao):.4f}\n")
        for eq in range(self.num_equipes):
            membros = [i + 1 for i, e in enumerate(solucao) if e == eq]
            print(f"Equipe {eq + 1} ({len(membros)} bairros): {membros}")
        print()

if __name__ == "__main__":
    app = TerritoriosGA()
    app.evolucao()
    app.saida()